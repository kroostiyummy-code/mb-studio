# Dépendances
node_modules/
dist/
.next/
.astro/

# Données clients (jamais commitées par défaut)
clients/*
!clients/.gitkeep
# Exception : maquette commerciale Le Cochon Dingue V2 (projet Astro versionné)
!clients/le-cochon-dingue-chartres/

# Audits générés
audits/
.audit-*/

# Prospects = ressource centrale vivante : versionnée dans le repo MB Studio (privé).
# Confidentialité = ne jamais publier HORS de ce repo privé (cf prospects/README.md).
# Seuls les caches techniques d'API restent hors git (volumineux, régénérables).
prospects/cache/

# Claude Code local settings (jamais commitées, propres à chaque poste)
.claude/settings.local.json

# Env / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Logs
*.log
npm-debug.log*
