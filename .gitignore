# Dépendances
node_modules/
dist/
.next/
.astro/

# Données clients (jamais commitées)
clients/*
!clients/.gitkeep

# Audits générés
audits/
.audit-*/

# Prospects générés (liste de prospection = donnée sensible : jamais commitée, reste en local seulement — cf scoring-prospects garde-fou #7)
prospects/*
!prospects/.gitkeep

# Claude Code local settings (jamais commitées, propres à chaque poste)
.claude/settings.local.json

# Env / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Logs
*.log
npm-debug.log*
