---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

import Bandeau from '../components/sections/Bandeau.astro';
import Hero from '../components/sections/Hero.astro';
import Histoire from '../components/sections/Histoire.astro';
import Avis from '../components/sections/Avis.astro';
import Reservation from '../components/sections/Reservation.astro';
import Menu from '../components/sections/Menu.astro';
import Exigence from '../components/sections/Exigence.astro';
import Galerie from '../components/sections/Galerie.astro';
import Localisation from '../components/sections/Localisation.astro';
import Reseaux from '../components/sections/Reseaux.astro';
import Footer from '../components/sections/Footer.astro';
import StickyCallBar from '../components/sections/StickyCallBar.astro';

const entry = await getEntry('settings', 'site');
const s = entry!.data;

// Note : l'auto-hide intelligent (galerie<4 photos, avis<4.0/20) sera branché ici dans
// la phase suivante quand on aura les collections galerie/avis. Pour l'instant on respecte
// uniquement le ON/OFF de settings.sections.X. Le tout est compilé conditionnellement
// (early-returns) → les sections désactivées ne sont PAS dans le HTML final.
---
<Layout>
  {s.sections.bandeau && <Bandeau />}
  <Hero />
  {s.sections.histoire && <Histoire />}
  {s.sections.avis && <Avis />}
  {s.sections.reservation && <Reservation />}
  {s.sections.menu && <Menu />}
  {s.sections.exigence && <Exigence />}
  {s.sections.galerie && <Galerie />}
  {s.sections.localisation && <Localisation />}
  {s.sections.reseaux && <Reseaux />}
  <Footer />
  <StickyCallBar />
</Layout>
