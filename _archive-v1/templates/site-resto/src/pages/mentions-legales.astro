---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const annee = new Date().getFullYear();
---
<Layout>
  <section class="legal">
    <div class="legal-wrap">
      <a href="/" class="back">← Retour</a>
      <h2>Mentions légales</h2>

      <h3>Éditeur du site</h3>
      <p>{s.nom}, basé à {s.adresse ?? s.ville}.</p>

      <h3>Contact</h3>
      <p>Téléphone : <a href={`tel:${s.telephone}`}>{s.telephone_display}</a></p>

      <h3>Hébergeur</h3>
      <p>Cloudflare, Inc. — 101 Townsend Street, San Francisco, CA 94107, États-Unis. cloudflare.com</p>

      <h3>Propriété intellectuelle</h3>
      <p>L'ensemble du contenu de ce site (textes, photos, design) est la propriété exclusive de {s.nom}. Toute reproduction non autorisée est interdite et constitue une contrefaçon au sens du code de la propriété intellectuelle.</p>

      <h3>Données personnelles & cookies</h3>
      <p>Ce site ne collecte aucune donnée personnelle, n'utilise aucun cookie de suivi, et ne conserve aucune information sur ses visiteurs.</p>

      <h3>Liens hypertextes</h3>
      <p>Ce site peut contenir des liens vers d'autres sites (Google, Instagram, Facebook…). {s.nom} décline toute responsabilité concernant les contenus, politiques de confidentialité ou pratiques de ces sites tiers.</p>

      <h3>Loi applicable</h3>
      <p>Le présent site est soumis au droit français. En cas de litige, les tribunaux français sont seuls compétents.</p>

      <p class="updated">Dernière mise à jour : {annee}.</p>

      <a href="/" class="back back-bottom">← Retour au site</a>
    </div>
  </section>
</Layout>

<style>
  .legal {
    background: var(--mb-cream);
    color: var(--mb-black);
    padding: 60px var(--mb-section-px) 130px;
    min-height: 100vh;
    position: relative;
    z-index: 2;
  }
  .legal-wrap {
    max-width: 640px;
    margin: 0 auto;
  }
  .legal h2 {
    font-family: var(--mb-display);
    font-size: clamp(2rem, 8vw, 3rem);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin: 24px 0 28px;
    line-height: 0.9;
    color: var(--mb-dominante);
  }
  .legal h3 {
    font-family: var(--mb-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-top: 28px;
    margin-bottom: 8px;
    color: var(--mb-dominante);
  }
  .legal p {
    font-family: var(--mb-sans);
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: 8px;
  }
  .legal a {
    color: var(--mb-dominante);
    text-decoration: underline;
  }
  .back {
    display: inline-block;
    font-family: var(--mb-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 14px;
    text-decoration: none !important;
  }
  .back-bottom {
    margin-top: 32px;
  }
  .updated {
    margin-top: 28px;
    opacity: 0.6;
    font-size: 0.85rem;
  }
</style>
