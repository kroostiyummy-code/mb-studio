---
interface Props {
  name: string;
  description: string;
  anchor?: string;
}
const { name, description, anchor } = Astro.props;
---
<section class="section-stub" id={anchor}>
  <div class="stub-inner mb-reveal">
    <div class="stub-label">Section · à étoffer</div>
    <div class="stub-name">{name}</div>
    <p>{description}</p>
  </div>
</section>

<style>
  .section-stub {
    padding: 50px var(--mb-section-px);
    border-top: 2px dashed rgba(244, 234, 213, 0.25);
    border-bottom: 2px dashed rgba(244, 234, 213, 0.25);
    position: relative;
    z-index: 2;
  }
  .stub-inner {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
  }
  .stub-label {
    font-family: var(--mb-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mb-accent);
    margin-bottom: 10px;
    opacity: 0.7;
  }
  .stub-name {
    font-family: var(--mb-display);
    font-size: clamp(1.6rem, 6vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .section-stub p {
    font-family: var(--mb-sans);
    font-size: 0.95rem;
    opacity: 0.7;
    line-height: 1.4;
  }
</style>
