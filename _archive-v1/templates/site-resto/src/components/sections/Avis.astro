---
import { getEntry } from 'astro:content';
import { shouldShowAvis } from '../../lib/conditions';

const entry = await getEntry('settings', 'site');
const s = entry!.data;

// Auto-hide : si pas de note/count OU note < 4.0 OU count < 20, on ne rend rien.
const data = s.avis_google;
const show = !!data && shouldShowAvis(data.note, data.count);

// Formatage de la note en français (5.0 → "5,0")
const noteFr = data ? data.note.toFixed(1).replace('.', ',') : '';
// Tronquer count au plus proche 10 inférieur pour le "170+"
const countRound = data ? Math.floor(data.count / 10) * 10 : 0;
---
{show && data && (
  <>
    <div class="mb-divider">Avis Google</div>
    <section class="section-avis" id="avis">
      <div class="avis-inner mb-reveal">
        <div class="google-badge">
          <svg class="google-g" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
            <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
            <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/>
            <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
          </svg>
          <div class="google-badge-text">
            <span class="g-line-1">Avis vérifiés</span>
            <span class="g-line-2">sur Google</span>
          </div>
        </div>

        <div class="avis-display">
          <span class="avis-num">{countRound}</span>
          <span class="avis-plus">+</span>
        </div>
        <div class="avis-stars" aria-hidden="true">★ ★ ★ ★ ★</div>
        <p class="avis-label">{noteFr} / 5,0</p>
        <p class="avis-sub">— Note moyenne sur Google</p>

        {s.google_avis_url && (
          <div class="avis-cta-row">
            <a href={s.google_avis_url} target="_blank" rel="noopener" class="avis-cta">
              <svg viewBox="0 0 48 48" aria-hidden="true" class="cta-g">
                <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
                <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
                <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/>
                <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
              </svg>
              Lire les avis Google
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10"/>
              </svg>
            </a>
          </div>
        )}
      </div>
    </section>
  </>
)}

<style>
  .section-avis {
    background: var(--mb-cream);
    color: var(--mb-dominante);
    padding: 60px var(--mb-section-px);
    border-top: 3px solid var(--mb-cream);
    border-bottom: 3px solid var(--mb-cream);
    position: relative;
    overflow: hidden;
    text-align: center;
    z-index: 2;
  }

  /* Google badge — pill blanche avec logo et texte type "Google" */
  .google-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1.5px solid #dadce0;
    border-radius: 999px;
    padding: 8px 16px 8px 12px;
    margin: 0 auto 28px;
    box-shadow: 0 1px 3px rgba(60, 64, 67, 0.12);
  }
  .google-g {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .google-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    font-family: 'Barlow Condensed', system-ui, sans-serif;
    text-align: left;
  }
  .g-line-1 {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #5f6368;
    text-transform: uppercase;
  }
  .g-line-2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #202124;
  }

  .avis-display {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    margin: 12px 0 16px;
  }
  .avis-num {
    font-family: var(--mb-display);
    font-size: clamp(8rem, 38vw, 18rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--mb-dominante);
  }
  .avis-plus {
    font-family: var(--mb-display);
    font-size: clamp(3rem, 12vw, 6rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--mb-dominante-bright);
    margin-top: 0.1em;
  }
  .avis-stars {
    display: flex;
    justify-content: center;
    gap: 8px;
    font-size: 1.6rem;
    color: #FBBC04;
    margin-bottom: 8px;
    letter-spacing: 0.04em;
  }
  .avis-label {
    text-align: center;
    font-family: var(--mb-display);
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    margin-bottom: 6px;
    color: var(--mb-dominante);
  }
  .avis-sub {
    text-align: center;
    font-family: var(--mb-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 30px;
    color: var(--mb-dominante);
    opacity: 0.7;
  }

  .avis-cta-row {
    display: flex;
    justify-content: center;
  }
  /* CTA Google : pill blanche avec logo + arrow externe — code Google-friendly */
  .avis-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #202124;
    border: 1.5px solid #dadce0;
    font-family: 'Barlow Condensed', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 14px 22px;
    border-radius: var(--mb-r-md);
    box-shadow: 0 1px 3px rgba(60, 64, 67, 0.12);
    transition: transform 0.15s, box-shadow 0.2s;
  }
  .avis-cta:hover {
    background: #f8f9fa;
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--mb-dominante);
  }
  .avis-cta .cta-g {
    width: 18px;
    height: 18px;
  }
  .avis-cta .arrow-svg {
    width: 16px;
    height: 16px;
    color: #5f6368;
  }

  /* ===== Surcharges signature Élégante ===== */
  :global(.signature-gastro) .section-avis {
    background: var(--mb-bg-section-alt);
  }
  :global(.signature-gastro) .avis-label {
    text-transform: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  :global(.signature-gastro) .avis-sub {
    font-style: italic;
    font-family: var(--mb-display);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  :global(.signature-gastro) .avis-cta {
    border-radius: 4px;
    text-transform: none;
  }

  /* ===== Surcharges signature Tradition ===== */
  :global(.signature-traditionnel) .section-avis {
    background: var(--mb-bg-section-alt);
    border-top: 2px solid var(--mb-dominante);
    border-bottom: 2px solid var(--mb-dominante);
  }
  :global(.signature-traditionnel) .avis-label {
    font-variant: small-caps;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  :global(.signature-traditionnel) .avis-sub {
    font-variant: small-caps;
    text-transform: none;
    font-family: var(--mb-display);
  }
  :global(.signature-traditionnel) .avis-cta {
    border-radius: 4px;
    font-variant: small-caps;
    border-color: var(--mb-dominante);
  }

  @media (min-width: 900px) {
    .section-avis {
      padding: 80px var(--mb-section-px);
    }
  }
</style>
