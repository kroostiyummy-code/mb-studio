---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const e = s.exigence;

function renderEmphasis(text: string): string {
  return text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---
{e && (
  <>
    <div class="mb-divider">Notre exigence</div>
    <section class="section-exigence" id="exigence">
      {e.headline_parts.length > 0 && (
        <h2 class="exigence-headline mb-reveal">
          {e.headline_parts.map((part, i) => (
            <>
              <span set:html={renderEmphasis(part)} />
              {i < e.headline_parts.length - 1 && <br />}
            </>
          ))}
        </h2>
      )}

      {e.items.length > 0 && (
        <ul class="exigence-list mb-reveal">
          {e.items.map((item, i) => (
            <li>
              <span class="nbr">{String(i + 1).padStart(2, '0')}</span>
              <span class="what">{item}</span>
              <span class="check">✓</span>
            </li>
          ))}
        </ul>
      )}

      {e.banner && (
        <div class="exigence-banner mb-reveal">
          <span class="banner-titre">{e.banner.titre}</span>
          {e.banner.sub && <span class="banner-sub">{e.banner.sub}</span>}
        </div>
      )}
    </section>
  </>
)}

<style>
  .section-exigence {
    background: var(--mb-black);
    color: var(--mb-cream);
    padding: 60px var(--mb-section-px);
    border-top: 3px solid var(--mb-border);
    border-bottom: 3px solid var(--mb-border);
    position: relative;
    z-index: 2;
  }

  .exigence-headline {
    font-family: var(--mb-display);
    font-size: clamp(2rem, 10vw, 5.5rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 36px;
    color: var(--mb-cream);
  }
  .exigence-headline :global(strong) {
    color: var(--mb-accent);
    font-weight: inherit;
  }

  .exigence-list {
    list-style: none;
    border-top: 2px solid var(--mb-cream);
    margin: 0;
    padding: 0;
  }
  .exigence-list li {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 18px 4px;
    border-bottom: 2px solid var(--mb-cream);
  }
  .exigence-list .nbr {
    font-family: var(--mb-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--mb-accent);
  }
  .exigence-list .what {
    font-family: var(--mb-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--mb-cream);
  }
  .exigence-list .check {
    font-size: 1.4rem;
    color: var(--mb-accent);
    font-weight: 700;
  }

  .exigence-banner {
    margin-top: 30px;
    background: var(--mb-accent);
    color: var(--mb-text-on-accent);
    padding: 18px 22px;
    border: 2px solid var(--mb-cream);
    border-radius: var(--mb-r-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .banner-titre {
    font-family: var(--mb-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .banner-sub {
    font-family: var(--mb-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Surcharges signature Élégante : fond dominante, hairlines, mixed case */
  :global(.signature-gastro) .section-exigence {
    background: var(--mb-dominante);
    color: var(--mb-cream);
  }
  :global(.signature-gastro) .exigence-headline {
    text-transform: none;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  :global(.signature-gastro) .exigence-headline :global(strong) {
    color: var(--mb-accent);
    font-style: italic;
    font-weight: 600;
  }
  :global(.signature-gastro) .exigence-list {
    border-top-color: var(--mb-border-subtle);
    border-top-width: 1px;
  }
  :global(.signature-gastro) .exigence-list li {
    border-bottom-color: var(--mb-border-subtle);
    border-bottom-width: 1px;
  }
  :global(.signature-gastro) .exigence-list .what {
    text-transform: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  :global(.signature-gastro) .exigence-banner {
    background: var(--mb-accent);
    color: var(--mb-dominante);
    border: 1px solid var(--mb-accent);
  }
  :global(.signature-gastro) .banner-titre {
    text-transform: none;
    font-weight: 600;
  }

  /* Surcharges signature Tradition : fond ivoire, small-caps, bordures dominante */
  :global(.signature-traditionnel) .section-exigence {
    background: var(--mb-bg-section-alt);
    color: var(--mb-dominante);
    border-top: 2px solid var(--mb-dominante);
    border-bottom: 2px solid var(--mb-dominante);
  }
  :global(.signature-traditionnel) .exigence-headline {
    font-variant: small-caps;
    font-feature-settings: "smcp" 1;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--mb-dominante);
  }
  :global(.signature-traditionnel) .exigence-list {
    border-top-color: var(--mb-dominante);
  }
  :global(.signature-traditionnel) .exigence-list li {
    border-bottom-color: var(--mb-dominante);
  }
  :global(.signature-traditionnel) .exigence-list .what {
    font-variant: small-caps;
    text-transform: none;
    letter-spacing: 0.03em;
    color: var(--mb-dominante);
  }
  :global(.signature-traditionnel) .exigence-banner {
    background: var(--mb-dominante);
    color: var(--mb-cream);
    border: 2px solid var(--mb-dominante);
  }
  :global(.signature-traditionnel) .banner-titre {
    font-variant: small-caps;
    text-transform: none;
  }

  @media (min-width: 900px) {
    .section-exigence {
      padding: 80px var(--mb-section-px);
    }
  }
</style>
