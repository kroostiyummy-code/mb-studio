---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;

const h = s.histoire;
const anneeCourante = new Date().getFullYear();

// **mot** = emphase couleur accent ; ==mot== = surlignage marqueur (volontaire, parcimonieux)
function renderEmphasis(text: string): string {
  return text
    .replace(/==([^=]+)==/g, '<mark class="mb-marker">$1</mark>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---
{h && (
  <>
    <div class="mb-divider">Notre histoire</div>
    <section class="section-histoire" id="histoire">
      <h2 class="huge-statement mb-reveal">
        <span class="statement-lead">{h.statement_lead}</span>{' '}
        <span class="statement-accent">{h.statement_accent}</span>
      </h2>

      <p class="statement-body mb-reveal" set:html={renderEmphasis(h.body)} />

      <div class="timeline mb-reveal">
        <div class="timeline-cell timeline-cell--past">
          <div class="cell-label">— Lancement</div>
          <div class="cell-value">{h.lancement_year}</div>
        </div>
        <div class="timeline-cell">
          <div class="cell-label">— Encore là en</div>
          <div class="cell-value">{anneeCourante}</div>
        </div>
      </div>
    </section>
  </>
)}

<style>
  .section-histoire {
    padding: 50px var(--mb-section-px) 60px;
    position: relative;
    z-index: 2;
  }

  .huge-statement {
    font-family: var(--mb-display);
    font-size: clamp(3rem, 14vw, 7rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--mb-text-emphasis);
    margin-bottom: 24px;
  }
  .statement-lead {
    color: var(--mb-text-emphasis);
  }
  .statement-accent {
    color: var(--mb-accent);
  }

  /* Marqueur surligné = emphase VOLONTAIRE (==mot== dans le texte), pas un trait
     de signature. À utiliser avec parcimonie sur un mot/chiffre clé, jamais en
     systématique (sinon les sites se ressemblent). 100% CSS → zéro coût vitesse. */
  .statement-body :global(mark.mb-marker) {
    background: var(--mb-accent);
    color: var(--mb-text-on-accent);
    padding: 0.02em 0.18em;
    border-radius: 2px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .statement-body {
    font-family: var(--mb-sans);
    font-size: 1.15rem;
    line-height: 1.45;
    font-weight: 500;
    max-width: 540px;
    border-left: 4px solid var(--mb-accent);
    padding-left: 18px;
    color: var(--mb-text-body);
  }
  .statement-body :global(strong) {
    color: var(--mb-accent);
    font-weight: 700;
  }

  .timeline {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid var(--mb-border);
    border-radius: var(--mb-r-lg);
    overflow: hidden;
  }
  .timeline-cell {
    padding: 16px 18px;
    color: var(--mb-text-body);
  }
  .timeline-cell--past {
    border-right: 2px solid var(--mb-border);
    background: var(--mb-bg-section-light);
    color: var(--mb-dominante);
  }
  .cell-label {
    font-family: var(--mb-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 6px;
    opacity: 0.7;
  }
  .cell-value {
    font-family: var(--mb-display);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mb-text-emphasis);
  }
  .timeline-cell--past .cell-value {
    color: var(--mb-dominante);
  }

  /* ===== Surcharges signature Élégante =====
     Mixed case Playfair, body italique, timeline plus aérée. */
  :global(.signature-gastro) .huge-statement {
    text-transform: none;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  :global(.signature-gastro) .statement-accent {
    color: var(--mb-dominante);
    font-style: italic;
  }
  :global(.signature-gastro) .statement-body {
    border-left-color: var(--mb-dominante);
    font-style: italic;
    font-size: 1.1rem;
  }
  :global(.signature-gastro) .statement-body :global(strong) {
    color: var(--mb-dominante);
    font-style: normal;
  }
  :global(.signature-gastro) .timeline {
    border-color: var(--mb-border-subtle);
    border-width: 1px;
  }
  :global(.signature-gastro) .timeline-cell {
    padding: 22px 24px;
  }
  :global(.signature-gastro) .timeline-cell--past {
    border-right-color: var(--mb-border-subtle);
    border-right-width: 1px;
    background: var(--mb-bg-section-alt);
  }
  :global(.signature-gastro) .cell-value {
    font-weight: 600;
  }

  /* ===== Surcharges signature Tradition =====
     Bitter slab petites caps, body avec emphase dominante, timeline encadrement. */
  :global(.signature-traditionnel) .huge-statement {
    font-variant: small-caps;
    font-feature-settings: "smcp" 1;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  :global(.signature-traditionnel) .statement-accent {
    color: var(--mb-dominante);
  }
  :global(.signature-traditionnel) .statement-body {
    border-left: 4px solid var(--mb-dominante);
    font-family: var(--mb-display);
    font-size: 1.05rem;
    line-height: 1.5;
  }
  :global(.signature-traditionnel) .statement-body :global(strong) {
    color: var(--mb-dominante);
    font-weight: 700;
  }
  :global(.signature-traditionnel) .timeline {
    border: 2px solid var(--mb-dominante);
  }
  :global(.signature-traditionnel) .timeline-cell--past {
    border-right: 2px solid var(--mb-dominante);
  }
  :global(.signature-traditionnel) .cell-label {
    font-variant: small-caps;
    text-transform: none;
    font-family: var(--mb-display);
    letter-spacing: 0.05em;
  }

  @media (min-width: 900px) {
    .section-histoire {
      padding: 70px var(--mb-section-px);
    }
    .statement-body {
      font-size: 1.25rem;
    }
  }
</style>
