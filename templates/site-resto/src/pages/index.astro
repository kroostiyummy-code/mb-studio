---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

import Bandeau from '../components/sections/Bandeau.astro';
import Hero from '../components/sections/Hero.astro';
import Histoire from '../components/sections/Histoire.astro';
import Avis from '../components/sections/Avis.astro';
import Reservation from '../components/sections/Reservation.astro';
import Menu from '../components/sections/Menu.astro';
import Exigence from '../components/sections/Exigence.astro';
import Galerie from '../components/sections/Galerie.astro';
import Localisation from '../components/sections/Localisation.astro';
import Reseaux from '../components/sections/Reseaux.astro';
import Footer from '../components/sections/Footer.astro';
import StickyCallBar from '../components/sections/StickyCallBar.astro';

const entry = await getEntry('settings', 'site');
const s = entry!.data;

// L'ORCHESTRATION : l'ordre des sections vient de la partition (le moteur de
// différenciation), plus de l'ordre figé d'autrefois. Bandeau + Hero ancrés en
// tête ; Footer + barre d'appel ancrés en pied. Le reste = part.ordre.
const part = s.partition ?? {
  ordre: ['avis', 'menu', 'reservation', 'histoire', 'exigence', 'localisation'],
};
const REGISTRY = {
  histoire: Histoire, avis: Avis, reservation: Reservation, menu: Menu,
  exigence: Exigence, galerie: Galerie, localisation: Localisation, reseaux: Reseaux,
} as const;
const ordre = (part.ordre ?? []).filter((k): k is keyof typeof REGISTRY => k in REGISTRY);
---
<Layout>
  {s.sections?.bandeau && <Bandeau />}
  <Hero />
  {ordre.map((key) => {
    const Section = REGISTRY[key];
    return <Section />;
  })}
  <Footer />
  <StickyCallBar />
</Layout>
