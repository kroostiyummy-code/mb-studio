---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const annee = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand-block">
      <div class="footer-tagline">
        {s.nom}<br /><span class="accent">{s.ville}.</span>
      </div>
    </div>
    <div class="footer-info">
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={`tel:${s.telephone}`}>{s.telephone_display}</a></li>
          {s.google_avis_url && (
            <li><a href={s.google_avis_url} target="_blank" rel="noopener">Avis Google</a></li>
          )}
        </ul>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="#top">Accueil</a></li>
          {s.sections.menu && <li><a href="#menu">La carte</a></li>}
          {s.sections.localisation && <li><a href="#localisation">Nous trouver</a></li>}
          <li><a href="/mentions-legales">Mentions légales</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {annee} {s.nom.toUpperCase()} · {s.ville.toUpperCase()}</span>
    {s.est_year && <span>EST. {s.est_year}</span>}
  </div>
</footer>

<style>
  .footer {
    background: var(--mb-ink);
    color: color-mix(in oklab, var(--mb-paper) 78%, var(--mb-ink));
    padding: var(--mb-s-9) var(--mb-section-px) calc(var(--mb-s-9) + 70px);
  }
  .footer-grid { display: flex; flex-direction: column; gap: var(--mb-s-7); max-width: var(--mb-container); margin: 0 auto; }
  .footer-tagline {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 7vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--mb-paper);
  }
  .footer-tagline .accent { color: color-mix(in oklab, var(--mb-accent) 60%, var(--mb-paper)); font-style: italic; }
  .footer-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--mb-s-5);
    border-top: 1px solid rgba(247, 243, 236, 0.14);
    padding-top: var(--mb-s-6);
  }
  .footer-info h4 {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in oklab, var(--mb-paper) 55%, var(--mb-ink));
    margin-bottom: var(--mb-s-3);
  }
  .footer-info ul { list-style: none; }
  .footer-info li { margin-bottom: 7px; font-size: 0.95rem; }
  .footer-info a:hover { color: var(--mb-paper); }
  .footer-bottom {
    max-width: var(--mb-container);
    margin: var(--mb-s-6) auto 0;
    padding-top: var(--mb-s-4);
    border-top: 1px solid rgba(247, 243, 236, 0.14);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, var(--mb-paper) 42%, var(--mb-ink));
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--mb-s-2);
  }

  @media (min-width: 900px) {
    .footer-grid { flex-direction: row; gap: var(--mb-s-9); align-items: flex-start; }
    .footer-brand-block { flex: 1; }
    .footer-info { flex: 1; border-top: none; padding-top: 0; }
  }
</style>
