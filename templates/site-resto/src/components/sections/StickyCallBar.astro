---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
---
<div class="call-bar">
  <a href={`tel:${s.telephone}`} class="call">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    Appeler
  </a>
  {s.sections.reservation && (
    <a href="#reservation" class="reserve">Réserver →</a>
  )}
</div>

<style>
  .call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--mb-accent);
    color: var(--mb-black);
    border-top: 3px solid var(--mb-black);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    display: flex;
    gap: 10px;
    z-index: 50;
  }
  .call-bar a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 12px;
    font-family: var(--mb-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    border: 2px solid var(--mb-black);
    border-radius: var(--mb-r-md);
    transition: transform 0.12s;
  }
  .call-bar a:active {
    transform: scale(0.97);
  }
  .call-bar .call {
    background: var(--mb-black);
    color: var(--mb-accent);
  }
  .call-bar .reserve {
    background: var(--mb-dominante-deep);
    color: var(--mb-accent);
    border-color: var(--mb-black);
  }

  @media (min-width: 900px) {
    .call-bar {
      display: none;
    }
  }
</style>
