---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
---
<div class="call-bar">
  <a href={`tel:${s.telephone}`} class="call">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    Appeler
  </a>
  {s.sections.reservation && (
    <a href="#reservation" class="reserve">Réserver →</a>
  )}
</div>

<style>
  .call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: color-mix(in oklab, var(--mb-paper) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--mb-line);
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    display: flex;
    gap: 10px;
    z-index: 50;
  }
  .call-bar a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 12px;
    font-size: 0.98rem;
    font-weight: 600;
    border-radius: var(--mb-radius-pill);
    transition: transform 0.12s ease;
  }
  .call-bar a:active { transform: scale(0.98); }
  .call-bar .call { background: var(--mb-accent); color: var(--mb-on-accent); }
  .call-bar .reserve {
    background: transparent;
    color: var(--mb-ink);
    border: 1px solid var(--mb-line-strong);
  }

  @media (min-width: 900px) {
    .call-bar { display: none; }
  }
</style>
