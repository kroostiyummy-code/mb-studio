---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const messages = s.bandeau?.messages ?? [];

// On duplique la liste pour que le scroll infini paraisse continu
const loop = [...messages, ...messages];
---
{messages.length > 0 && (
  <div class="ticker" role="marquee" aria-label="Actualités">
    <div class="ticker-track">
      {loop.map((m, i) => (
        <>
          <span>{m}</span>
          {i < loop.length - 1 && <span class="sep">●</span>}
        </>
      ))}
    </div>
  </div>
)}

<style>
  .ticker {
    background: var(--mb-paper-2);
    color: var(--mb-ink-soft);
    border-bottom: 1px solid var(--mb-line);
    overflow: hidden;
    white-space: nowrap;
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 9px 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ticker-track {
    display: inline-block;
    animation: mb-ticker 46s linear infinite;
    padding-left: 100%;
  }
  .ticker-track span { margin: 0 18px; display: inline-block; }
  .ticker-track .sep { color: var(--mb-accent); font-size: 0.6rem; vertical-align: middle; }
  @keyframes mb-ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; padding-left: 0; text-align: center; }
  }
  @media (min-width: 900px) {
    .ticker-track { animation-duration: 64s; }
  }
</style>
