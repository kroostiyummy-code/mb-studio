---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const messages = s.bandeau?.messages ?? [];

// On duplique la liste pour que le scroll infini paraisse continu
const loop = [...messages, ...messages];
---
{messages.length > 0 && (
  <div class="ticker" role="marquee" aria-label="Actualités">
    <div class="ticker-track">
      {loop.map((m, i) => (
        <>
          <span>{m}</span>
          {i < loop.length - 1 && <span class="sep">●</span>}
        </>
      ))}
    </div>
  </div>
)}

<style>
  .ticker {
    background: var(--mb-accent);
    color: var(--mb-text-on-accent);
    border-bottom: 3px solid var(--mb-black);
    overflow: hidden;
    white-space: nowrap;
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 8px 0;
    font-family: var(--mb-condensed);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }
  .ticker-track {
    display: inline-block;
    animation: mb-ticker 32s linear infinite;
    padding-left: 100%;
  }
  .ticker-track span {
    margin: 0 22px;
    display: inline-block;
  }
  .ticker-track .sep {
    color: var(--mb-dominante);
    font-size: 0.7rem;
    vertical-align: middle;
  }
  @keyframes mb-ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation-duration: 90s; }
  }

  /* Surcharges signature Élégante : ticker plus discret sur fond cream-dirty */
  :global(.signature-elegant) .ticker {
    background: var(--mb-bg-section-alt);
    color: var(--mb-dominante);
    border-bottom: 1px solid var(--mb-border-subtle);
    font-family: var(--mb-display);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
  }
  :global(.signature-elegant) .ticker-track .sep {
    color: var(--mb-dominante);
    opacity: 0.4;
  }

  /* Surcharges signature Tradition : ticker chaleureux ivoire, petites caps */
  :global(.signature-tradition) .ticker {
    background: var(--mb-dominante);
    color: var(--mb-cream);
    border-bottom: 2px solid var(--mb-dominante);
    font-family: var(--mb-display);
    font-variant: small-caps;
    font-feature-settings: "smcp" 1;
    letter-spacing: 0.05em;
  }
  :global(.signature-tradition) .ticker-track .sep {
    color: var(--mb-accent);
  }

  @media (min-width: 900px) {
    .ticker-track { animation-duration: 48s; }
  }
</style>
