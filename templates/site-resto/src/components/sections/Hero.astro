---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const spine = s.partition?.spine ?? 'venir';
// CTA principal piloté par le spine : commander/appeler (S1), réserver = appel sinon.
const ctaLabel = spine === 'commander' ? 'Commander · Appeler' : 'Réserver une table';
---
<header class="hero" id="top">
  <div class="hero-media">
    <img src={s.hero_image} alt={s.hero_image_alt} loading="eager" fetchpriority="high" />
    <div class="hero-scrim"></div>
    <div class="hero-flag">
      <span class="mb-tag"><span class="mb-blink"></span>En service</span>
    </div>
  </div>

  <div class="hero-body mb-wrap">
    <p class="hero-kicker">{s.ville}{s.est_year && ` · Depuis ${s.est_year}`}</p>
    <h1 class="hero-name">{s.nom}</h1>
    <p class="hero-slogan">{s.slogan}</p>

    <div class="hero-row">
      {s.prix_appel && (
        <div class="hero-price">
          <span class="lbl">Menu complet dès</span>
          <span class="val">{s.prix_appel}</span>
        </div>
      )}
      <a href={`tel:${s.telephone}`} class="hero-cta" aria-label={`Appeler ${s.nom}`}>
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .hero { position: relative; background: var(--mb-paper); }

  .hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Léger dégradé NOIR en bas, uniquement pour lisibilité — jamais un voile couleur */
  .hero-scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,0.18) 0%, transparent 26%,
                                transparent 64%, rgba(0,0,0,0.42) 100%);
  }
  .hero-flag { position: absolute; top: 18px; left: 18px; }
  .hero-flag .mb-tag {
    background: rgba(255,255,255,0.86);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    color: var(--mb-ink);
  }

  .hero-body { padding-top: var(--mb-s-7); padding-bottom: var(--mb-s-7); }
  .hero-kicker {
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--mb-ink-soft);
    margin-bottom: var(--mb-s-4);
  }
  .hero-name {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 11vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--mb-ink);
  }
  .hero-slogan {
    margin-top: var(--mb-s-3);
    font-size: 1.12rem;
    color: var(--mb-ink-soft);
    max-width: 30rem;
  }

  .hero-row {
    margin-top: var(--mb-s-7);
    display: flex;
    align-items: center;
    gap: var(--mb-s-6);
    flex-wrap: wrap;
  }
  .hero-price { display: flex; flex-direction: column; }
  .hero-price .lbl {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--mb-ink-soft);
    margin-bottom: 2px;
  }
  .hero-price .val {
    font-family: var(--mb-display);
    font-size: 2rem; font-weight: 700; color: var(--mb-ink);
    letter-spacing: -0.02em;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--mb-accent); color: var(--mb-on-accent);
    padding: 16px 26px;
    border-radius: var(--mb-radius-pill);
    font-size: 1rem; font-weight: 600; letter-spacing: 0.01em;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .hero-cta svg { width: 18px; height: 18px; }
  .hero-cta:hover { background: var(--mb-accent-deep); transform: translateY(-1px); }

  @media (min-width: 900px) {
    .hero-media { aspect-ratio: 21 / 9; }
    .hero-body { padding-top: var(--mb-s-8); padding-bottom: var(--mb-s-8); }
    .hero-slogan { font-size: 1.25rem; }
  }
</style>
