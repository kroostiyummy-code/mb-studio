---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const r = s.reseaux;

type Reseau = { type: 'instagram' | 'facebook' | 'tiktok' | 'snapchat'; label: string; url: string };
const reseaux: Reseau[] = [];
if (r?.instagram) reseaux.push({ type: 'instagram', label: 'Instagram', url: r.instagram });
if (r?.facebook) reseaux.push({ type: 'facebook', label: 'Facebook', url: r.facebook });
if (r?.tiktok) reseaux.push({ type: 'tiktok', label: 'TikTok', url: r.tiktok });
if (r?.snapchat) reseaux.push({ type: 'snapchat', label: 'Snapchat', url: r.snapchat });

function getHandle(type: string, url: string): string {
  try {
    const u = new URL(url);
    const segments = u.pathname.split('/').filter(Boolean);
    if (type === 'instagram' || type === 'tiktok' || type === 'snapchat') {
      const h = segments[segments.length - 1] || segments[0] || '';
      return h.startsWith('@') ? h : `@${h}`;
    }
    return segments[segments.length - 1] || s.nom;
  } catch { return ''; }
}
---
{reseaux.length > 0 && (
  <>
    <div class="mb-divider">Suivez le resto</div>
    <section class="section-social" id="reseaux">
      <div class="social-wrap mb-wrap">
        <h2 class="social-title mb-reveal">
          L'emplacement du <span class="accent">jour.</span>
        </h2>
        <p class="social-sub mb-reveal">Coulisses, nouveautés, et où on est aujourd'hui. On poste tous les jours.</p>

        <div class="social-list mb-reveal">
          {reseaux.map(r => (
            <a href={r.url} target="_blank" rel="noopener" class={`social-link social-link--${r.type}`}>
              <span class="social-icon" aria-hidden="true">
