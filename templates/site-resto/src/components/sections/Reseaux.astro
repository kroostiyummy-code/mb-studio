                )}
                {r.type === 'facebook' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.5h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.27h3.33l-.53 3.5h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
                )}
                {r.type === 'tiktok' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 6.32a4.83 4.83 0 0 1-3.77-1.67V15.4a6.16 6.16 0 1 1-6.16-6.16c.13 0 .25.01.37.02v3.04a3.15 3.15 0 1 0 2.16 2.98V0h2.96a4.83 4.83 0 0 0 4.45 4.32v2z"/></svg>
                )}
                {r.type === 'snapchat' && (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.06 1c2.25 0 4.42 1.13 5.55 3.04.61 1.04.65 2.16.66 3.13.01.55.02 1.16.05 1.52.05.07.27.21.83.21.45 0 .96-.16 1.32-.27.13-.04.34-.1.55-.1.41 0 .76.24.86.59.1.32-.06.66-.4.93-.21.16-.55.32-.86.45-.34.15-1.05.45-1.13.83-.03.16.07.4.27.7.45.7 1.27 1.7 2.36 2.27.32.16.52.43.5.7-.01.18-.1.43-.46.66-.86.55-2.09.55-2.36 1.13-.13.32-.06.83-.36 1.13-.27.27-.7.27-1.13.27-.4 0-.86-.04-1.32.04-.68.13-1.18.74-1.5 1.04-.45.43-1.27 1.27-2.93 1.27-.18 0-.34 0-.5-.01h-.13c-.16.01-.32.01-.5.01-1.66 0-2.48-.83-2.93-1.27-.32-.3-.83-.91-1.5-1.04-.46-.08-.93-.04-1.32-.04-.43 0-.86 0-1.13-.27-.3-.3-.23-.81-.36-1.13-.27-.59-1.5-.58-2.36-1.13-.36-.23-.45-.48-.46-.66-.02-.27.18-.55.5-.7 1.09-.58 1.91-1.58 2.36-2.27.2-.3.3-.55.27-.7-.08-.39-.79-.69-1.13-.84-.32-.13-.66-.29-.86-.45-.34-.27-.5-.61-.4-.93.1-.35.45-.59.86-.59.21 0 .42.06.55.1.36.11.87.27 1.32.27.56 0 .78-.14.83-.21.04-.36.05-.97.05-1.52.01-.97.05-2.09.66-3.13C7.64 2.13 9.81 1 12.06 1z"/></svg>
                )}
              </span>
              <div class="social-text">
                <span class="social-label">{r.label}</span>
                <span class="social-handle">{getHandle(r.type, r.url)}</span>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </>
)}

<style>
  .section-social {
    padding: var(--mb-section-py) 0;
    background: var(--mb-paper);
  }
  .social-title {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--mb-ink);
    margin-bottom: var(--mb-s-3);
  }
  .social-title .accent { color: var(--mb-accent); font-style: italic; }
  .social-sub {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--mb-ink-soft);
    max-width: 28rem;
    margin-bottom: var(--mb-s-7);
  }

  .social-list { display: flex; flex-direction: column; }
  .social-link {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: var(--mb-s-4);
    align-items: center;
    padding: var(--mb-s-5) var(--mb-s-2);
    border-bottom: 1px solid var(--mb-line);
    color: var(--mb-ink);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }
  .social-link:first-child { border-top: 1px solid var(--mb-line); }
  .social-link:hover { padding-left: var(--mb-s-5); color: var(--mb-accent); }
  .social-icon svg { width: 24px; height: 24px; }
  .social-text { display: flex; flex-direction: column; }
  .social-label { font-size: 1.15rem; font-weight: 600; line-height: 1.2; }
  .social-handle {
    font-size: 0.82rem;
    color: var(--mb-ink-soft);
    margin-top: 2px;
  }
  .arrow { font-size: 1.2rem; color: var(--mb-ink-soft); transition: transform 0.2s ease; }
  .social-link:hover .arrow { transform: translateX(5px); color: var(--mb-accent); }
</style>
