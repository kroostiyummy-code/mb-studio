---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;

const h = s.histoire;
const anneeCourante = new Date().getFullYear();

// **mot** = emphase couleur accent ; ==mot== = surlignage marqueur (volontaire, parcimonieux)
function renderEmphasis(text: string): string {
  return text
    .replace(/==([^=]+)==/g, '<mark class="mb-marker">$1</mark>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---
{h && (
  <>
    <div class="mb-divider">Notre histoire</div>
    <section class="section-histoire" id="histoire">
      <div class="histoire-wrap mb-wrap">
        <h2 class="huge-statement mb-reveal">
          <span class="statement-lead">{h.statement_lead}</span>{' '}
          <span class="statement-accent">{h.statement_accent}</span>
        </h2>

        <p class="statement-body mb-reveal" set:html={renderEmphasis(h.body)} />

        <div class="timeline mb-reveal">
          <div class="timeline-cell timeline-cell--past">
            <div class="cell-label">Lancement</div>
            <div class="cell-value">{h.lancement_year}</div>
          </div>
          <div class="timeline-cell">
            <div class="cell-label">Encore là en</div>
            <div class="cell-value">{anneeCourante}</div>
          </div>
        </div>
      </div>
    </section>
  </>
)}

<style>
  .section-histoire {
    padding: var(--mb-section-py) 0;
    background: var(--mb-paper);
  }
  .huge-statement {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 9vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--mb-ink);
    margin-bottom: var(--mb-s-5);
  }
  .statement-accent { color: var(--mb-accent); font-style: italic; }

  .statement-body {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--mb-ink);
    max-width: var(--mb-measure);
    padding-left: var(--mb-s-5);
    border-left: 2px solid color-mix(in oklab, var(--mb-accent) 45%, transparent);
  }
  .statement-body :global(strong) { color: var(--mb-accent); font-weight: 600; }

  .timeline {
    margin-top: var(--mb-s-7);
    display: flex;
    gap: var(--mb-s-8);
    flex-wrap: wrap;
  }
  .timeline-cell { display: flex; flex-direction: column; }
  .cell-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mb-ink-soft);
    margin-bottom: var(--mb-s-2);
  }
  .cell-value {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    color: var(--mb-ink);
  }
  .timeline-cell--past .cell-value { color: var(--mb-accent); }

  @media (min-width: 900px) {
    .statement-body { font-size: 1.3rem; }
  }
</style>
