---
import { getEntry, getCollection } from 'astro:content';

const settingsEntry = await getEntry('settings', 'site');
const s = settingsEntry!.data;

const menuSections = (await getCollection('menu')).sort((a, b) => a.data.ordre - b.data.ordre);
---
<section class="section-menu" id="menu">
  <div class="menu-wrap mb-wrap">
    <h2 class="menu-title mb-reveal">
      Le menu.<br /><span class="accent">Tout est là.</span>
    </h2>

    {s.combo?.active && (
      <div class="combo mb-reveal">
        <span class="combo-tag">{s.combo.tag}</span>
        <div class="combo-formula">
          {s.combo.formule.split('+').map((part, i, arr) => (
            <>
              <span class="formula-part">{part.trim()}</span>
              {i < arr.length - 1 && <span class="plus">+</span>}
            </>
          ))}
        </div>
        <div class="combo-price">{s.combo.prix}<span class="cur">€</span></div>
      </div>
    )}

    {menuSections.map(section => (
      <div class="menu-section">
        <div class="menu-section-divider mb-reveal">
          <span>{section.data.nom_section}</span>
        </div>
        <div class="menu-items">
          {section.data.items.map(item => (
            <div class="menu-item mb-reveal">
              <div class="item-body">
                <div class="item-name">{item.nom}</div>
                <div class="item-desc">{item.description}</div>
                {item.allergenes.length > 0 && (
                  <div class="item-allergens">
                    <span class="allergens-label">Allergènes</span>
                    {item.allergenes.map(a => <span class="allergen-pill">{a}</span>)}
                  </div>
                )}
              </div>
              <div class="item-price">{item.prix}<span class="cur">€</span></div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .section-menu {
    padding: var(--mb-section-py) 0;
    background: var(--mb-paper);
  }
  .menu-title {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 9vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--mb-s-7);
    color: var(--mb-ink);
  }
  .menu-title .accent { color: var(--mb-accent); }

  /* Combo : carte accent dosée, pas un bloc jaune brut */
  .combo {
    position: relative;
    background: color-mix(in oklab, var(--mb-accent) 7%, var(--mb-paper));
    border: 1px solid color-mix(in oklab, var(--mb-accent) 24%, transparent);
    border-radius: var(--mb-radius);
    padding: var(--mb-s-6) var(--mb-s-5);
    margin-bottom: var(--mb-s-7);
  }
  .combo-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mb-accent);
    margin-bottom: var(--mb-s-3);
  }
  .combo-formula {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--mb-ink);
    margin-bottom: var(--mb-s-3);
  }
  .combo-formula .formula-part { display: inline-block; }
  .combo-formula .plus { color: var(--mb-ink-soft); margin: 0 6px; }
  .combo-price {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 12vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mb-accent);
  }
  .combo-price .cur {
    font-size: 0.4em;
    vertical-align: super;
    margin-left: 4px;
  }

  .menu-section-divider {
    margin: var(--mb-s-7) 0 var(--mb-s-2);
  }
  .menu-section-divider span {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--mb-ink-soft);
  }

  .menu-items { display: flex; flex-direction: column; }
  .menu-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--mb-s-5);
    align-items: baseline;
    padding: var(--mb-s-5) 0;
    border-bottom: 1px solid var(--mb-line);
  }
  .menu-item:first-child { border-top: 1px solid var(--mb-line); }
  .item-name {
    font-family: var(--mb-display);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--mb-ink);
    margin-bottom: 4px;
  }
  .item-desc {
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--mb-ink-soft);
    max-width: 34rem;
  }
  .item-allergens {
    margin-top: var(--mb-s-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .item-allergens .allergens-label { color: var(--mb-ink-soft); margin-right: 4px; }
  .item-allergens .allergen-pill {
    padding: 3px 9px;
    border: 1px solid var(--mb-line);
    border-radius: var(--mb-radius-pill);
    color: var(--mb-ink-soft);
  }
  .item-price {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mb-ink);
    text-align: right;
  }
  .item-price .cur { font-size: 0.6em; vertical-align: super; margin-left: 1px; }

  @media (min-width: 900px) {
    .item-name { font-size: 1.6rem; }
  }
</style>
