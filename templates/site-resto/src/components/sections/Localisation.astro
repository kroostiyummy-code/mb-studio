---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;

const joursLabels: Record<string, string> = {
  lundi: 'Lun', mardi: 'Mar', mercredi: 'Mer', jeudi: 'Jeu',
  vendredi: 'Ven', samedi: 'Sam', dimanche: 'Dim',
};

const ordreJours = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'] as const;

// Pour foodtruck : on remplit les créneaux midi/soir pour chaque jour pour avoir une grille complète
type CrenoFT = { lieu: string; ville: string; moment: 'midi'|'soir'; ouvre: string; ferme: string };
type LigneFT = { jour: string; midi: CrenoFT | null; soir: CrenoFT | null };

const ligneFoodtruck: LigneFT[] = s.mode === 'foodtruck'
  ? ordreJours.map(jour => {
      const data = s.horaires_foodtruck?.find(h => h.jour === jour);
      const creneaux = data?.creneaux ?? [];
      return {
        jour,
        midi: creneaux.find(c => c.moment === 'midi') ?? null,
        soir: creneaux.find(c => c.moment === 'soir') ?? null,
      };
    })
  : [];

// Pour mode fixe : récupère les créneaux par jour
const ligneFixe = s.mode === 'fixe'
  ? ordreJours.map(jour => {
      const data = s.horaires?.find(h => h.jour === jour);
      return { jour, creneaux: data?.creneaux ?? [] };
    })
  : [];

// Lien itinéraire Google Maps depuis adresse
const itineraireUrl = s.adresse
  ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(s.adresse)}`
  : null;
---
<section class="section-where" id="localisation">
  {s.mode === 'foodtruck' ? (
    <>
      <h2 class="where-title mb-reveal">
        La <span class="accent">semaine.</span>
      </h2>
      <p class="where-sub mb-reveal">Midi 11h30—13h30 · Soir 18h30—20h30</p>

      <div class="schedule-grid mb-reveal">
        {ligneFoodtruck.map(({ jour, midi, soir }) => {
          const fullClosed = !midi && !soir;
          return (
            <div class={`sched-row${fullClosed ? ' full-closed' : ''}`}>
              <div class="day">{joursLabels[jour]}</div>
              {fullClosed ? (
                <div class="slots"><div class="slot closed">— Fermé —</div></div>
              ) : (
                <div class="slots">
                  {midi ? (
                    <div class="slot open">
                      <strong>{midi.lieu}</strong>
                      <small>{midi.ville} · Midi</small>
                    </div>
                  ) : <div class="slot closed">×</div>}
                  {soir ? (
                    <div class="slot open">
                      <strong>{soir.lieu}</strong>
                      <small>{soir.ville} · Soir</small>
                    </div>
                  ) : <div class="slot closed">×</div>}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <div class="legend">
        <div class="legend-item"><span class="sw"></span>Ouvert</div>
        <div class="legend-item"><span class="sw off"></span>Fermé ce créneau</div>
      </div>

      <a href={`tel:${s.telephone}`} class="where-cta mb-reveal">
        Réservez au {s.telephone_display}
        <span class="small">— Évitez la queue</span>
      </a>
    </>
  ) : (
    <>
      <h2 class="where-title mb-reveal">
        Où nous <span class="accent">trouver.</span>
      </h2>
      {s.adresse && (
        <p class="where-address mb-reveal">{s.adresse}</p>
      )}

      <div class="hours-grid mb-reveal">
        {ligneFixe.map(({ jour, creneaux }) => (
          <div class={`hours-row${creneaux.length === 0 ? ' closed-row' : ''}`}>
            <div class="hours-day">{joursLabels[jour]}</div>
            <div class="hours-slots">
              {creneaux.length === 0 ? (
                <span class="closed-label">— Fermé —</span>
              ) : (
                creneaux.map((c, i) => (
                  <span class="hours-slot">
                    {c.ouvre.replace(':', 'h')}—{c.ferme.replace(':', 'h')}
                    {i < creneaux.length - 1 && <span class="sep"> · </span>}
                  </span>
                ))
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="cta-row mb-reveal">
        {itineraireUrl && (
          <a href={itineraireUrl} target="_blank" rel="noopener" class="where-cta">
            Itinéraire <span class="arrow">→</span>
          </a>
        )}
        <a href={`tel:${s.telephone}`} class="where-cta secondary">
          Appeler le {s.telephone_display}
        </a>
      </div>

      {s.google_maps_embed_url && (
        <div class="map-wrap mb-reveal">
          <iframe
            src={s.google_maps_embed_url}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Carte de ${s.nom}`}
            allowfullscreen
          />
        </div>
      )}
    </>
  )}
</section>

<style>
  .section-where {
    padding: 50px var(--mb-section-px) 60px;
    position: relative;
    z-index: 2;
  }
  .where-title {
    font-family: var(--mb-display);
    font-size: clamp(2rem, 10vw, 5.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 8px;
    color: var(--mb-text-emphasis);
  }
  .where-title .accent {
    color: var(--mb-accent);
  }
  .where-sub,
  .where-address {
    font-family: var(--mb-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mb-text-muted);
    margin-bottom: 30px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--mb-border);
  }

  /* ===== MODE FOODTRUCK : grille 7j × 2 créneaux ===== */
  .schedule-grid {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--mb-border);
    border-radius: var(--mb-r-lg);
    overflow: hidden;
  }
  .sched-row {
    display: grid;
    grid-template-columns: 54px 1fr;
    border-bottom: 1px solid var(--mb-border-subtle);
    min-height: 74px;
  }
  .sched-row:last-child {
    border-bottom: none;
  }
  .sched-row .day {
    font-family: var(--mb-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 2px solid var(--mb-border);
    padding: 14px 4px;
    background: var(--mb-bg-section-alt);
    text-align: center;
    color: var(--mb-text-emphasis);
  }
  .sched-row .slots {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .sched-row .slot {
    padding: 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--mb-border-subtle);
    font-size: 0.78rem;
    line-height: 1.2;
    overflow: hidden;
  }
  .sched-row .slot:last-child {
    border-right: none;
  }
  .sched-row .slot.open {
    background: var(--mb-accent);
    color: var(--mb-text-on-accent);
  }
  .sched-row .slot.open strong {
    display: block;
    font-family: var(--mb-display);
    font-size: 0.82rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 3px;
  }
  .sched-row .slot.open small {
    font-family: var(--mb-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--mb-text-on-accent);
    opacity: 0.7;
    text-transform: uppercase;
  }
  .sched-row .slot.closed {
    color: var(--mb-text-muted);
    font-family: var(--mb-mono);
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sched-row.full-closed .day {
    background: transparent;
    color: var(--mb-text-muted);
  }
  .sched-row.full-closed .slots {
    grid-template-columns: 1fr;
  }
  .sched-row.full-closed .slots .slot {
    font-size: 0.85rem;
    font-family: var(--mb-mono);
    letter-spacing: 0.1em;
  }

  .legend {
    margin-top: 18px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--mb-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--mb-text-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend-item .sw {
    width: 12px;
    height: 12px;
    background: var(--mb-accent);
  }
  .legend-item .sw.off {
    background: transparent;
    border: 1px solid var(--mb-border);
  }

  /* ===== MODE FIXE : grille hebdo simple + Google Maps ===== */
  .hours-grid {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--mb-border);
    border-radius: var(--mb-r-lg);
    overflow: hidden;
  }
  .hours-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    border-bottom: 1px solid var(--mb-border-subtle);
    min-height: 54px;
    align-items: center;
  }
  .hours-row:last-child {
    border-bottom: none;
  }
  .hours-day {
    font-family: var(--mb-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-align: center;
    padding: 12px 8px;
    background: var(--mb-bg-section-alt);
    border-right: 2px solid var(--mb-border);
    color: var(--mb-text-emphasis);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hours-slots {
    padding: 12px 16px;
    font-family: var(--mb-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--mb-text-body);
  }
  .hours-slot .sep {
    color: var(--mb-text-muted);
    margin: 0 6px;
  }
  .closed-row .hours-day {
    color: var(--mb-text-muted);
    background: transparent;
  }
  .closed-label {
    color: var(--mb-text-muted);
    font-family: var(--mb-mono);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .map-wrap {
    margin-top: 30px;
    border: 2px solid var(--mb-border);
    border-radius: var(--mb-r-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .map-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* CTAs */
  .cta-row {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .where-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--mb-accent);
    color: var(--mb-text-on-accent);
    padding: 18px 20px;
    font-family: var(--mb-display);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-align: center;
    border: 2px solid var(--mb-border);
    border-radius: var(--mb-r-lg);
    box-shadow: 6px 6px 0 var(--mb-border);
    transition: transform 0.15s, box-shadow 0.15s;
    margin-top: 30px;
  }
  .where-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--mb-border);
  }
  .where-cta .small {
    display: block;
    font-family: var(--mb-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mb-text-on-accent);
    opacity: 0.7;
    margin-top: 4px;
  }
  .where-cta .arrow {
    font-family: var(--mb-mono);
    font-size: 1rem;
  }
  .where-cta.secondary {
    background: transparent;
    color: var(--mb-text-emphasis);
    box-shadow: none;
    border-color: var(--mb-border);
    font-size: 1rem;
    padding: 14px 18px;
    margin-top: 0;
  }
  .where-cta.secondary:hover {
    background: var(--mb-bg-section-alt);
    transform: none;
  }
  .cta-row .where-cta {
    margin-top: 0;
  }

  /* Surcharges signature */
  :global(.signature-elegant) .where-title,
  :global(.signature-elegant) .sched-row .day,
  :global(.signature-elegant) .hours-day {
    text-transform: none;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  :global(.signature-elegant) .where-cta {
    box-shadow: none;
    border-width: 1px;
    background: var(--mb-dominante);
    color: var(--mb-cream);
    text-transform: none;
    font-weight: 600;
  }
  :global(.signature-elegant) .where-cta:hover {
    transform: none;
    opacity: 0.9;
  }
  :global(.signature-elegant) .sched-row .slot.open {
    background: var(--mb-dominante);
    color: var(--mb-cream);
  }
  :global(.signature-elegant) .sched-row .slot.open small {
    color: var(--mb-cream);
    opacity: 0.75;
  }
  :global(.signature-elegant) .legend-item .sw {
    background: var(--mb-dominante);
  }

  :global(.signature-tradition) .where-title,
  :global(.signature-tradition) .sched-row .day,
  :global(.signature-tradition) .hours-day {
    font-variant: small-caps;
    font-feature-settings: "smcp" 1;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  :global(.signature-tradition) .where-cta {
    background: var(--mb-dominante);
    color: var(--mb-cream);
    box-shadow: 4px 4px 0 var(--mb-dominante);
    font-variant: small-caps;
    text-transform: none;
  }
  :global(.signature-tradition) .sched-row .slot.open {
    background: var(--mb-dominante);
    color: var(--mb-cream);
  }
  :global(.signature-tradition) .sched-row .slot.open strong {
    font-variant: small-caps;
  }
  :global(.signature-tradition) .sched-row .slot.open small {
    color: var(--mb-cream);
    opacity: 0.75;
  }
  :global(.signature-tradition) .legend-item .sw {
    background: var(--mb-dominante);
  }

  @media (min-width: 900px) {
    .section-where {
      padding: 70px var(--mb-section-px);
    }
    .schedule-grid .sched-row {
      grid-template-columns: 100px 1fr;
    }
    .cta-row {
      flex-direction: row;
    }
    .cta-row .where-cta {
      flex: 1;
    }
  }
</style>
