---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;

const joursLabels: Record<string, string> = {
  lundi: 'Lun', mardi: 'Mar', mercredi: 'Mer', jeudi: 'Jeu',
  vendredi: 'Ven', samedi: 'Sam', dimanche: 'Dim',
};

const ordreJours = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'] as const;

type CrenoFT = { lieu: string; ville: string; moment: 'midi'|'soir'; ouvre: string; ferme: string };
type LigneFT = { jour: string; midi: CrenoFT | null; soir: CrenoFT | null };

const ligneFoodtruck: LigneFT[] = s.mode === 'foodtruck'
  ? ordreJours.map(jour => {
      const data = s.horaires_foodtruck?.find(h => h.jour === jour);
      const creneaux = data?.creneaux ?? [];
      return {
        jour,
        midi: creneaux.find(c => c.moment === 'midi') ?? null,
        soir: creneaux.find(c => c.moment === 'soir') ?? null,
      };
    })
  : [];

const ligneFixe = s.mode === 'fixe'
  ? ordreJours.map(jour => {
      const data = s.horaires?.find(h => h.jour === jour);
      return { jour, creneaux: data?.creneaux ?? [] };
    })
  : [];

const itineraireUrl = s.adresse
  ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(s.adresse)}`
  : null;
---
<section class="section-where" id="localisation">
  <div class="where-wrap mb-wrap">
  {s.mode === 'foodtruck' ? (
    <>
      <h2 class="where-title mb-reveal">
        La <span class="accent">semaine.</span>
      </h2>
      <p class="where-sub mb-reveal">Midi 11h30—13h30 · Soir 18h30—20h30</p>

      <div class="schedule mb-reveal">
        {ligneFoodtruck.map(({ jour, midi, soir }) => {
          const fullClosed = !midi && !soir;
          return (
            <div class={`sched-row${fullClosed ? ' full-closed' : ''}`}>
              <div class="day">{joursLabels[jour]}</div>
              {fullClosed ? (
                <div class="slots"><div class="slot closed">Fermé</div></div>
              ) : (
                <div class="slots">
                  {midi ? (
                    <div class="slot open">
                      <strong>{midi.lieu}</strong>
                      <small>{midi.ville} · Midi</small>
                    </div>
                  ) : <div class="slot closed">—</div>}
                  {soir ? (
                    <div class="slot open">
                      <strong>{soir.lieu}</strong>
                      <small>{soir.ville} · Soir</small>
                    </div>
                  ) : <div class="slot closed">—</div>}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <a href={`tel:${s.telephone}`} class="where-cta mb-reveal">
        Réservez au {s.telephone_display}
        <span class="small">Évitez la queue</span>
      </a>
    </>
  ) : (
    <>
      <h2 class="where-title mb-reveal">
        Où nous <span class="accent">trouver.</span>
      </h2>
      {s.adresse && (
        <p class="where-sub mb-reveal">{s.adresse}</p>
      )}

      <div class="schedule mb-reveal">
        {ligneFixe.map(({ jour, creneaux }) => (
          <div class={`sched-row${creneaux.length === 0 ? ' full-closed' : ''}`}>
            <div class="day">{joursLabels[jour]}</div>
            <div class="hours">
              {creneaux.length === 0 ? (
                <span class="closed-label">Fermé</span>
              ) : (
                creneaux.map((c, i) => (
                  <span class="hours-slot">
                    {c.ouvre.replace(':', 'h')}—{c.ferme.replace(':', 'h')}
                    {i < creneaux.length - 1 && <span class="sep"> · </span>}
                  </span>
                ))
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="cta-row mb-reveal">
        {itineraireUrl && (
          <a href={itineraireUrl} target="_blank" rel="noopener" class="where-cta">
            Itinéraire
          </a>
        )}
        <a href={`tel:${s.telephone}`} class="where-cta secondary">
          Appeler le {s.telephone_display}
        </a>
      </div>

      {s.google_maps_embed_url && (
        <div class="map-wrap mb-reveal">
          <iframe
            src={s.google_maps_embed_url}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Carte de ${s.nom}`}
            allowfullscreen
          />
        </div>
      )}
    </>
  )}
  </div>
</section>

<style>
  .section-where {
    padding: var(--mb-section-py) 0;
    background: var(--mb-paper);
  }
  .where-title {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 9vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--mb-ink);
    margin-bottom: var(--mb-s-3);
  }
  .where-title .accent { color: var(--mb-accent); }
  .where-sub {
    font-size: 0.95rem;
    color: var(--mb-ink-soft);
    margin-bottom: var(--mb-s-7);
  }

  .schedule { display: flex; flex-direction: column; }
  .sched-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: stretch;
    border-bottom: 1px solid var(--mb-line);
    min-height: 70px;
  }
  .sched-row:first-child { border-top: 1px solid var(--mb-line); }
  .sched-row .day {
    display: flex;
    align-items: center;
    font-family: var(--mb-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--mb-ink);
  }
  .sched-row .slots { display: grid; grid-template-columns: 1fr 1fr; gap: var(--mb-s-4); }
  .sched-row .slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--mb-s-3) 0;
  }
  .sched-row .slot.open strong {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--mb-ink);
    line-height: 1.2;
  }
  .sched-row .slot.open small {
    font-size: 0.74rem;
    color: var(--mb-accent);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }
  .sched-row .slot.closed {
    justify-content: center;
    color: var(--mb-ink-soft);
    font-size: 0.9rem;
  }
  .sched-row.full-closed .day,
  .sched-row.full-closed .slot.closed,
  .closed-label { color: color-mix(in oklab, var(--mb-ink-soft) 60%, transparent); }

  .hours {
    display: flex;
    align-items: center;
    font-size: 0.95rem;
    color: var(--mb-ink);
  }
  .hours .sep { color: var(--mb-ink-soft); margin: 0 6px; }
  .closed-label { font-size: 0.9rem; }

  .map-wrap {
    margin-top: var(--mb-s-7);
    border-radius: var(--mb-radius);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--mb-line);
  }
  .map-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }

  .cta-row {
    margin-top: var(--mb-s-6);
    display: flex;
    flex-direction: column;
    gap: var(--mb-s-3);
  }
  .where-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: var(--mb-accent);
    color: var(--mb-on-accent);
    padding: 17px 26px;
    border-radius: var(--mb-radius-pill);
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
    margin-top: var(--mb-s-7);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .where-cta:hover { background: var(--mb-accent-deep); transform: translateY(-1px); }
  .where-cta .small {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .where-cta.secondary {
    background: transparent;
    color: var(--mb-ink);
    border: 1px solid var(--mb-line-strong);
    margin-top: 0;
  }
  .where-cta.secondary:hover { background: var(--mb-paper-2); transform: none; }
  .cta-row .where-cta { margin-top: 0; }

  @media (min-width: 900px) {
    .sched-row { grid-template-columns: 100px 1fr; }
    .cta-row { flex-direction: row; }
    .cta-row .where-cta { flex: 1; }
  }
</style>
