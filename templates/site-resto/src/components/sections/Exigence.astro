---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
const e = s.exigence;

function renderEmphasis(text: string): string {
  return text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---
{e && (
  <>
    <div class="mb-divider">Notre exigence</div>
    <section class="section-exigence" id="exigence">
      <div class="exigence-wrap mb-wrap">
        {e.headline_parts.length > 0 && (
          <h2 class="exigence-headline mb-reveal">
            {e.headline_parts.map((part, i) => (
              <>
                <span set:html={renderEmphasis(part)} />
                {i < e.headline_parts.length - 1 && <br />}
              </>
            ))}
          </h2>
        )}

        {e.items.length > 0 && (
          <ul class="exigence-list mb-reveal">
            {e.items.map((item, i) => (
              <li>
                <span class="nbr">{String(i + 1).padStart(2, '0')}</span>
                <span class="what">{item}</span>
                <span class="check" aria-hidden="true">✓</span>
              </li>
            ))}
          </ul>
        )}

        {e.banner && (
          <div class="exigence-banner mb-reveal">
            <span class="banner-titre">{e.banner.titre}</span>
            {e.banner.sub && <span class="banner-sub">{e.banner.sub}</span>}
          </div>
        )}
      </div>
    </section>
  </>
)}

<style>
  .section-exigence {
    padding: var(--mb-section-py) 0;
    background: var(--mb-paper);
  }
  .exigence-headline {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: var(--mb-s-7);
    color: var(--mb-ink);
  }
  .exigence-headline :global(strong) { color: var(--mb-accent); font-weight: inherit; font-style: italic; }

  .exigence-list { list-style: none; margin: 0; padding: 0; }
  .exigence-list li {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: var(--mb-s-4);
    align-items: center;
    padding: var(--mb-s-5) 0;
    border-bottom: 1px solid var(--mb-line);
  }
  .exigence-list li:first-child { border-top: 1px solid var(--mb-line); }
  .exigence-list .nbr {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--mb-accent);
  }
  .exigence-list .what {
    font-size: 1.1rem;
    color: var(--mb-ink);
  }
  .exigence-list .check { font-size: 1rem; color: var(--mb-accent); }

  .exigence-banner {
    margin-top: var(--mb-s-7);
    background: color-mix(in oklab, var(--mb-accent) 7%, var(--mb-paper));
    border: 1px solid color-mix(in oklab, var(--mb-accent) 22%, transparent);
    border-radius: var(--mb-radius);
    padding: var(--mb-s-5) var(--mb-s-6);
    display: flex;
    align-items: baseline;
    gap: var(--mb-s-4);
    flex-wrap: wrap;
  }
  .banner-titre {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--mb-accent);
  }
  .banner-sub {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mb-ink-soft);
  }
</style>
