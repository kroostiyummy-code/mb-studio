---
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;

// Défauts si le patron n'a rien rempli (le composant fonctionne hors-Kroosti)
const kicker = s.reservation?.kicker ?? 'Une table en vue ?';
const titre = s.reservation?.titre ?? 'Réservez votre table.';
const perks = s.reservation?.perks?.length
  ? s.reservation.perks
  : ['Service rapide', 'Accueil chaleureux', 'À votre arrivée'];
---
<section class="section-reserve" id="reservation">
  <div class="reserve-inner mb-wrap mb-reveal">
    <p class="reserve-kicker">{kicker}</p>
    <h2 class="reserve-headline" set:html={titre.replace(/ ([^ ]+\.?)$/, '<br />$1')} />

    <a href={`tel:${s.telephone}`} class="reserve-phone" aria-label={`Appeler ${s.nom} au ${s.telephone_display}`}>
      <svg class="phone-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      {s.telephone_display}
    </a>

    <div class="reserve-perks">
      {perks.map(p => (
        <span class="perk">
          <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          {p}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .section-reserve {
    background: var(--mb-paper-2);
    padding: var(--mb-section-py) 0;
    text-align: center;
  }
  .reserve-inner { display: flex; flex-direction: column; align-items: center; }
  .reserve-kicker {
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--mb-ink-soft);
    margin-bottom: var(--mb-s-4);
  }
  .reserve-headline {
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--mb-ink);
    margin-bottom: var(--mb-s-7);
  }
  .reserve-phone {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--mb-accent);
    color: var(--mb-on-accent);
    padding: 18px 30px;
    border-radius: var(--mb-radius-pill);
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 6vw, 2rem);
    letter-spacing: -0.01em;
    line-height: 1;
    margin-bottom: var(--mb-s-6);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .reserve-phone:hover { background: var(--mb-accent-deep); transform: translateY(-1px); }
  .reserve-phone .phone-ico { width: 24px; height: 24px; flex-shrink: 0; }

  .reserve-perks {
    display: flex;
    justify-content: center;
    gap: var(--mb-s-5);
    flex-wrap: wrap;
    font-size: 0.95rem;
    color: var(--mb-ink-soft);
  }
  .perk { display: inline-flex; align-items: center; gap: 7px; }
  .perk .check { width: 15px; height: 15px; flex-shrink: 0; color: var(--mb-accent); }
</style>
