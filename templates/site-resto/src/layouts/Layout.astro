---
import { getEntry } from 'astro:content';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/base.css';

const entry = await getEntry('settings', 'site');
if (!entry) throw new Error('settings/site.yml manquant');
const settings = entry.data;

// Langue visuelle unique : l'accent EST la couleur réelle du resto (dominante),
// utilisée avec parcimonie. accent_override reste possible (pilotage Mike).
const accent = settings.accent_override ?? settings.dominante;

// La partition pilote l'orchestration. Défauts neutres si absente (compat).
const part = settings.partition ?? {
  spine: 'venir', hero: 'direct', tempo: 2, densite: 2, media: 2, motion: 2,
  ordre: ['avis', 'menu', 'reservation', 'histoire', 'exigence', 'localisation'],
};

// Polices premium figées préchargées (le strict nécessaire au LCP)
const fontPreloads = ['inter-400.woff2', 'inter-600.woff2', 'playfair-display-700.woff2'];

const pageTitle = `${settings.nom} — ${settings.slogan}`;
const pageDescription = settings.baseline ?? settings.slogan;

// Mapping jours FR → noms schema.org
const JOURS_FR_TO_EN: Record<string, string> = {
  lundi: 'Monday', mardi: 'Tuesday', mercredi: 'Wednesday', jeudi: 'Thursday',
  vendredi: 'Friday', samedi: 'Saturday', dimanche: 'Sunday',
};

// openingHoursSpecification depuis horaires (mode fixe) OU horaires_foodtruck
type OpeningHourSpec = { '@type': 'OpeningHoursSpecification'; dayOfWeek: string; opens: string; closes: string };
const openingHours: OpeningHourSpec[] = [];
if (settings.mode === 'fixe' && settings.horaires) {
  for (const ligne of settings.horaires) {
    for (const c of ligne.creneaux) {
      openingHours.push({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: JOURS_FR_TO_EN[ligne.jour],
        opens: c.ouvre,
        closes: c.ferme,
      });
    }
  }
} else if (settings.mode === 'foodtruck' && settings.horaires_foodtruck) {
  for (const ligne of settings.horaires_foodtruck) {
    for (const c of ligne.creneaux) {
      openingHours.push({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: JOURS_FR_TO_EN[ligne.jour],
        opens: c.ouvre,
        closes: c.ferme,
      });
    }
  }
}

// areaServed pour foodtruck : villes uniques tirées des horaires
const villesFoodtruck = settings.mode === 'foodtruck' && settings.horaires_foodtruck
  ? [...new Set(settings.horaires_foodtruck.flatMap(l => l.creneaux.map(c => c.ville)))]
  : [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: settings.nom,
  description: pageDescription,
  url: Astro.site?.toString(),
  telephone: settings.telephone,
  image: settings.hero_image,
  ...(settings.prix_appel ? { priceRange: '€' } : {}),
  ...(settings.adresse ? {
    address: {
      '@type': 'PostalAddress',
      addressLocality: settings.ville,
      addressRegion: settings.region_code,
      addressCountry: 'FR',
    },
  } : {}),
  ...(settings.geo ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: settings.geo.lat,
      longitude: settings.geo.lng,
    },
  } : {}),
  ...(openingHours.length > 0 ? { openingHoursSpecification: openingHours } : {}),
  ...(villesFoodtruck.length > 0 ? {
    areaServed: villesFoodtruck.map(v => ({ '@type': 'City', name: v })),
  } : {}),
  ...(settings.reseaux ? {
    sameAs: Object.values(settings.reseaux).filter(Boolean),
  } : {}),
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow" />
  <meta name="geo.region" content={settings.region_code} />
  <meta name="geo.placename" content={settings.ville} />
  <meta name="theme-color" content={settings.dominante} />

  <meta property="og:type" content="restaurant" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={settings.hero_image} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={settings.nom} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={settings.hero_image} />

  {fontPreloads.map((f) => (
    <link rel="preload" href={`/fonts/${f}`} as="font" type="font/woff2" crossorigin />
  ))}

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <style is:global define:vars={{ dominante: settings.dominante, accent }}>
    :root {
      --mb-dominante: var(--dominante);
      --mb-dominante-deep: color-mix(in oklab, var(--dominante) 70%, #000);
      --mb-dominante-bright: color-mix(in oklab, var(--dominante) 70%, #fff);
      --mb-accent: var(--accent);
      --mb-accent-soft: color-mix(in oklab, var(--accent) 85%, #fff);
    }
  </style>
</head>
<body data-spine={part.spine} data-tempo={part.tempo} data-motion={part.motion} data-media={part.media}>
  <slot />

  <script>
    // Active les animations seulement si JS fonctionne (sinon contenu visible par défaut)
    document.body.classList.add('js-loaded');

    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('show');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('.mb-reveal').forEach(el => io.observe(el));

    // Fallback : forcer l'affichage des reveal qui n'ont pas déclenché après 3s
    setTimeout(() => {
      document.querySelectorAll('.mb-reveal:not(.show)').forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight + 200) {
          el.classList.add('show');
        }
      });
    }, 3000);
  </script>
</body>
</html>
