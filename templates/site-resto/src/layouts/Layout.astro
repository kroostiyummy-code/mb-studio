---
import { getEntry } from 'astro:content';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/signatures/brutalist.css';
import '../styles/signatures/elegant.css';
import '../styles/signatures/tradition.css';
// Packs typo auto-hébergés (différenciation inter-clients, cf differenciation-clients.md).
// Le @font-face n'est chargé par le navigateur que si le pack est l'actif (data-typo-pack).
import '../styles/typo-packs/brutalist-base.css';

const entry = await getEntry('settings', 'site');
if (!entry) throw new Error('settings/site.yml manquant');
const settings = entry.data;

// Accent par défaut selon signature (Mike peut override via accent_override dans settings)
const ACCENT_DEFAULTS = {
  brutalist: '#ffec00',  // jaune acide
  elegant:   '#c9a961',  // doré champagne
  tradition: '#b8553a',  // rouille brique
} as const;

const accent = settings.accent_override ?? ACCENT_DEFAULTS[settings.signature];

// Pont Google : utilisé UNIQUEMENT pour les signatures pas encore migrées en pack auto-hébergé.
const FONT_URLS = {
  brutalist: 'https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=JetBrains+Mono:wght@400;500;700&family=Barlow+Condensed:wght@400;500;700;800;900&display=swap',
  elegant:   'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap',
  tradition: 'https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;700;800&family=Source+Sans+3:wght@300;400;600&family=JetBrains+Mono:wght@400;500&display=swap',
} as const;

// --- Système de packs typo (différenciation inter-clients) ---
// Un pack = un jeu de polices DANS une signature. Pack auto-hébergé = 0 requête tierce.
// Tant qu'une signature n'a pas de pack auto-hébergé, on garde le pont Google ci-dessus.
const TYPO_PACKS: Record<string, Record<string, { preload: string[] }>> = {
  brutalist: {
    // Look identique à la signature Brutaliste d'origine, mais auto-hébergé.
    'brutalist-base': { preload: ['archivo-black-400.woff2', 'barlow-condensed-500.woff2'] },
  },
};
const DEFAULT_PACK: Record<string, string | null> = {
  brutalist: 'brutalist-base',
  elegant: null,
  tradition: null,
};
const packId = settings.pack_typo ?? DEFAULT_PACK[settings.signature] ?? null;
const packDef = packId ? (TYPO_PACKS[settings.signature]?.[packId] ?? null) : null;
if (settings.pack_typo && !packDef) {
  throw new Error(`pack_typo "${settings.pack_typo}" inconnu pour la signature "${settings.signature}"`);
}
const selfHostedFonts = packDef !== null;                                  // pack local → pas de Google
const fontUrl = selfHostedFonts ? null : FONT_URLS[settings.signature];    // sinon pont Google
const fontPreloads = packDef?.preload ?? [];
const bodyClass = `signature-${settings.signature}`;

const pageTitle = `${settings.nom} — ${settings.slogan}`;
const pageDescription = settings.baseline ?? settings.slogan;

// Mapping jours FR → noms schema.org
const JOURS_FR_TO_EN: Record<string, string> = {
  lundi: 'Monday', mardi: 'Tuesday', mercredi: 'Wednesday', jeudi: 'Thursday',
  vendredi: 'Friday', samedi: 'Saturday', dimanche: 'Sunday',
};

// openingHoursSpecification depuis horaires (mode fixe) OU horaires_foodtruck
type OpeningHourSpec = { '@type': 'OpeningHoursSpecification'; dayOfWeek: string; opens: string; closes: string };
const openingHours: OpeningHourSpec[] = [];
if (settings.mode === 'fixe' && settings.horaires) {
  for (const ligne of settings.horaires) {
    for (const c of ligne.creneaux) {
      openingHours.push({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: JOURS_FR_TO_EN[ligne.jour],
        opens: c.ouvre,
        closes: c.ferme,
      });
    }
  }
} else if (settings.mode === 'foodtruck' && settings.horaires_foodtruck) {
  for (const ligne of settings.horaires_foodtruck) {
    for (const c of ligne.creneaux) {
      openingHours.push({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: JOURS_FR_TO_EN[ligne.jour],
        opens: c.ouvre,
        closes: c.ferme,
      });
    }
  }
}

// areaServed pour foodtruck : villes uniques tirées des horaires
const villesFoodtruck = settings.mode === 'foodtruck' && settings.horaires_foodtruck
  ? [...new Set(settings.horaires_foodtruck.flatMap(l => l.creneaux.map(c => c.ville)))]
  : [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: settings.nom,
  description: pageDescription,
  url: Astro.site?.toString(),
  telephone: settings.telephone,
  image: settings.hero_image,
  ...(settings.prix_appel ? { priceRange: '€' } : {}),
  ...(settings.adresse ? {
    address: {
      '@type': 'PostalAddress',
      addressLocality: settings.ville,
      addressRegion: settings.region_code,
      addressCountry: 'FR',
    },
  } : {}),
  ...(settings.geo ? {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: settings.geo.lat,
      longitude: settings.geo.lng,
    },
  } : {}),
  ...(openingHours.length > 0 ? { openingHoursSpecification: openingHours } : {}),
  ...(villesFoodtruck.length > 0 ? {
    areaServed: villesFoodtruck.map(v => ({ '@type': 'City', name: v })),
  } : {}),
  ...(settings.reseaux ? {
    sameAs: Object.values(settings.reseaux).filter(Boolean),
  } : {}),
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow" />
  <meta name="geo.region" content={settings.region_code} />
  <meta name="geo.placename" content={settings.ville} />
  <meta name="theme-color" content={settings.dominante} />

  <meta property="og:type" content="restaurant" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={settings.hero_image} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={settings.nom} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={settings.hero_image} />

  {selfHostedFonts
    ? fontPreloads.map((f) => (
        <link rel="preload" href={`/fonts/${f}`} as="font" type="font/woff2" crossorigin />
      ))
    : (
      <Fragment>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontUrl} />
      </Fragment>
    )}

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <style is:global define:vars={{ dominante: settings.dominante, accent }}>
    :root {
      --mb-dominante: var(--dominante);
      --mb-dominante-deep: color-mix(in oklab, var(--dominante) 70%, #000);
      --mb-dominante-bright: color-mix(in oklab, var(--dominante) 70%, #fff);
      --mb-accent: var(--accent);
      --mb-accent-soft: color-mix(in oklab, var(--accent) 85%, #fff);
    }
  </style>
</head>
<body class={bodyClass} data-typo-pack={packId ?? undefined}>
  <slot />

  <script>
    // Active les animations seulement si JS fonctionne (sinon contenu visible par défaut)
    document.body.classList.add('js-loaded');

    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('show');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('.mb-reveal').forEach(el => io.observe(el));

    // Fallback : forcer l'affichage des reveal qui n'ont pas déclenché après 3s
    setTimeout(() => {
      document.querySelectorAll('.mb-reveal:not(.show)').forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight + 200) {
          el.classList.add('show');
        }
      });
    }, 3000);
  </script>
</body>
</html>
