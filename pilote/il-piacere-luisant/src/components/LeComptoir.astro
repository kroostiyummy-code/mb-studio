---
---
<section id="le-comptoir" aria-labelledby="le-comptoir-titre" class="bg-background">
  <div class="mx-auto max-w-screen-xl px-5 md:px-10 py-section">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
      <figure class="md:col-span-7 md:order-1 order-2">
        <img
          src="/images/comptoir.webp"
          alt="Comptoir du bar Il Piacere avec étagère de bouteilles et lumière chaude"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[3/2] object-cover"
        />
      </figure>
      <div class="md:col-span-5 md:order-2 order-1">
        <p class="kicker mb-5">LE COMPTOIR</p>
        <h2 id="le-comptoir-titre" class="font-serif text-headline-lg text-cream">
          On commence par un spritz.
        </h2>
        <p class="editorial-paragraph mt-6 text-cream-variant">
          Aperol, limoncello, Saint Germain, Campari.
          Et un Il Piacere Spritz maison — limoncello, prosecco, cassis.
          Avant la pizza. Pendant. Après.
        </p>
        <a href="#cave-italienne" class="inline-block mt-6 font-serif italic text-terracotta editorial-link">
          Voir toute la carte des cocktails →
        </a>
      </div>
    </div>
  </div>
</section>
