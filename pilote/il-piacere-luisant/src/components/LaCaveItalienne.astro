---
import etablissement from '../data/etablissement.json';
const rouges = etablissement.carteVinsRouges;
const blancs = etablissement.carteVinsBlancs;

function ligne(nom: string, prix: string) {
  const dots = '.'.repeat(Math.max(2, 36 - nom.length));
  return { nom, dots, prix };
}
---
<section id="cave-italienne" aria-labelledby="cave-italienne-titre" class="bg-surface-low">
  <div class="mx-auto max-w-screen-xl px-5 md:px-10 py-section">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-start">
      <figure class="md:col-span-5">
        <img
          src="/images/cave-bouteilles.webp"
          alt="Bouteilles de vin rouge italien sur étagère avec lampes orange en arrière-plan"
          width="900"
          height="1125"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[4/5] object-cover"
        />
      </figure>
      <div class="md:col-span-7">
        <p class="kicker mb-5">LA CAVE ITALIENNE</p>
        <h2 id="cave-italienne-titre" class="font-serif text-headline-lg text-cream">
          Les vins viennent de chez eux.
        </h2>
        <p class="editorial-paragraph mt-6 text-cream-variant max-w-[480px]">
          Toscane, Piémont, Pouilles, Vénétie, Sicile.
          Au verre, en pichet ou à la bouteille.
        </p>

        <div class="mt-10 space-y-8">
          <div>
            <h3 class="kicker-soft text-cuivre-brule mb-4">ROUGES ITALIENS</h3>
            <ul class="divide-y divide-outline-variant/25">
              {rouges.map((v) => (
                <li class="flex items-baseline justify-between py-3 gap-4">
                  <span class="font-serif italic text-cream text-body-md md:text-body-lg">{v.nom}</span>
                  <span class="font-mono text-cream-variant text-sm tracking-wide whitespace-nowrap">
                    {v.prixVerre === 'bouteille uniquement' ? v.prixVerre : `${v.prixVerre} le verre`}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="kicker-soft text-cuivre-brule mb-4">BLANCS ITALIENS</h3>
            <ul class="divide-y divide-outline-variant/25">
              {blancs.map((v) => (
                <li class="flex items-baseline justify-between py-3 gap-4">
                  <span class="font-serif italic text-cream text-body-md md:text-body-lg">{v.nom}</span>
                  <span class="font-mono text-cream-variant text-sm tracking-wide whitespace-nowrap">
                    {v.prixVerre} le verre
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <p class="font-serif italic text-terracotta mt-10">
          Demandez à Antonio de vous conseiller.
        </p>
      </div>
    </div>
  </div>
</section>
