---
import FilmGrain from './FilmGrain.astro';
---
<section
  id="le-feu"
  aria-labelledby="le-feu-titre"
  class="relative bg-surface-lowest"
>
  <!-- Photo principale full-bleed (le four signature) -->
  <div class="relative w-full h-[65vh] md:h-[85vh] overflow-hidden">
    <img
      src="/images/feu-four-complet.webp"
      alt="Pizza Margherita sortant du four à bois d'Il Piacere, mozzarella bouillonnée, bords du cornicione noircis, flammes visibles à l'arrière dans la gueule du four"
      width="1920"
      height="1280"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(180deg, rgba(21,12,5,0.35) 0%, rgba(21,12,5,0.1) 40%, rgba(21,12,5,0.85) 100%);"
    ></div>
    <div
      class="absolute inset-0 pointer-events-none mix-blend-multiply"
      style="background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.45) 100%);"
    ></div>
    <FilmGrain opacity={0.15} />

    <div class="absolute inset-0 mx-auto max-w-screen-xl px-5 md:px-10 flex flex-col justify-end pb-16 md:pb-24">
      <div class="max-w-[640px]">
        <p class="kicker mb-5">LE FOUR</p>
        <h2 id="le-feu-titre" class="font-serif text-display-lg text-cream">
          Le four porte le nom du restaurant.
        </h2>
        <p class="editorial-paragraph mt-6 max-w-[520px] text-cream-variant">
          Construit à la main, signé en mosaïque bleue. Bois, braises,
          quatre-vingt-dix secondes à quatre cent cinquante degrés.
          La croûte gonfle, les bords noircissent, la mozzarella bouillonne.
          C'est ce qu'on voit en arrivant.
        </p>
      </div>
    </div>
  </div>

  <!-- Triple composition sous-jacente — grille asymétrique éditoriale -->
  <div class="mx-auto max-w-screen-xl px-5 md:px-10 py-20 md:py-section">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start">
      <figure class="md:col-span-6 md:row-span-2">
        <img
          src="/images/feu-flammes-bois.webp"
          alt="Bûche en feu sur le lit de braises dans le four à pizza d'Il Piacere, flammes orange éclatant sur fond noir"
          width="900"
          height="1125"
          loading="lazy"
          decoding="async"
          class="w-full h-auto"
        />
        <figcaption class="micro-label text-cream-variant/70 mt-3">
          PHOTO 1 · LA BÛCHE EN FEU
        </figcaption>
      </figure>

      <figure class="md:col-span-6 md:mt-12">
        <img
          src="/images/feu-pate-gros-plan.webp"
          alt="Gros plan sur le cornicione d'une pizza Margherita Il Piacere : croûte gonflée, bords noircis, mozzarella bouillonnée et basilic"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
          class="w-full h-auto"
        />
        <figcaption class="micro-label text-cream-variant/70 mt-3">
          PHOTO 2 · LA CROÛTE QUI GONFLE
        </figcaption>
      </figure>

      <figure class="md:col-span-6">
        <img
          src="/images/feu-flammes-noires.webp"
          alt="Vue à l'intérieur du four à 450 degrés : flammes au fond, hearth orangé, pizza en pleine cuisson au premier plan"
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
          class="w-full h-auto"
        />
        <figcaption class="micro-label text-cream-variant/70 mt-3">
          PHOTO 3 · 450°C EN COULISSES
        </figcaption>
      </figure>
    </div>
  </div>
</section>
