---
---

<section id="carte" class="bg-ink">
  <div class="grid grid-cols-1 md:grid-cols-2">
    <figure class="relative h-[60vh] md:h-auto fade-in-up">
      <img
        src="/placeholders/pate-chartres-signature.svg"
        alt="Le Pâté de Chartres au foie gras et pistaches, recommandé Gault & Millau 2023, 2024, 2025"
        class="h-full w-full object-cover"
        width="1400"
        height="1750"
        loading="lazy"
        style="aspect-ratio: 4 / 5;"
      />
    </figure>

    <div class="flex items-center px-6 py-24 md:px-16 md:py-32 fade-in-up delay-150">
      <div class="max-w-md">
        <p class="kicker">La signature</p>
        <h2 class="display-italic mt-8 text-bone" style="font-size: clamp(2.25rem, 4.5vw, 3.5rem);">
          Le pâté refroidit lentement. La réputation aussi.
        </h2>

        <div class="mt-10 space-y-6 text-lg leading-relaxed text-bone">
          <p>Foie gras au centre, éclats de pistaches, pâte dorée tressée à la main.</p>
          <p>Une recette devenue l'une des signatures gourmandes de Chartres.</p>
        </div>

        <p class="kicker mt-10">Recommandé Gault &amp; Millau 2023 · 2024 · 2025</p>
      </div>
    </div>
  </div>
</section>
