---
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://le-cochon-dingue-chartres.pages.dev';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Le Cochon Dingue',
  image: [
    `${site}/assets/images/hero-devanture.webp`,
    `${site}/assets/images/comptoir-charcuterie.webp`,
    `${site}/assets/images/cave-lustre.webp`,
  ],
  url: site,
  telephone: '+33237213098',
  priceRange: '€€',
  servesCuisine: ['Charcuterie', 'Cuisine française traditionnelle', 'Traiteur'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5 Rue de la Pie',
    addressLocality: 'Chartres',
    postalCode: '28000',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 48.4475,
    longitude: 1.4889,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '20:30',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.7',
    reviewCount: '143',
  },
  acceptsReservations: 'True',
  sameAs: ['https://www.facebook.com/lecochondingue28'],
  award: [
    'Recommandé Gault & Millau Artisan 2023',
    'Recommandé Gault & Millau Artisan 2024',
    'Recommandé Gault & Millau Artisan 2025',
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
