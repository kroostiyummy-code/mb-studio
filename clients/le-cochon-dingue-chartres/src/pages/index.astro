---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GaultMillau from '../components/GaultMillau.astro';
import Esprit from '../components/Esprit.astro';
import PateSignature from '../components/PateSignature.astro';
import Comptoir from '../components/Comptoir.astro';
import Specialites from '../components/Specialites.astro';
import TransitionSilence from '../components/TransitionSilence.astro';
import Cave from '../components/Cave.astro';
import Avis from '../components/Avis.astro';
import Venir from '../components/Venir.astro';
import Footer from '../components/Footer.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
---

<BaseLayout>
  <main>
    <Hero />
    <GaultMillau />
    <Esprit />
    <PateSignature />
    <Comptoir />
    <Specialites />
    <TransitionSilence />
    <Cave />
    <Avis />
    <Venir />
  </main>
  <Footer />
  <GrainOverlay />
</BaseLayout>
