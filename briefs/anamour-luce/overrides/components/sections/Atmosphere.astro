---
// L'Art de la Table — image tablée vivante + texte + badge floating "Convivialité"
const heroLounge = "https://lh3.googleusercontent.com/aida-public/AB6AXuBz5bH5QO3BNpU3JVUkhkFbo5Y1J8wIkg_LoSQ3p5P_X_fjiopIYzSAZV2nl8U-Wmf_al0CWyaublEWIg5DzX2Moiio7XIIHrRpfFGFn5LD4_DLX4dQOl7ju1-ViVomYXm7WvGp7ptG6m56bLMhXCS9nSukNwjDW5hxn3-F0ok-6Cl63HrfSIoOsPtJB2X8jRV8G4D-N422PTmDOWQlU36zlNzx2rJZIwyKl775pJZxPlyKQu3EVprTfAn67dA6jJUYNvT1q58DVUXu";
---
<section class="atmosphere" id="atmosphere">
  <div class="atmosphere-wrap">
    <div class="atmo-media mb-reveal">
      <img src={heroLounge} alt="Grande tablée animée à Anamour — plats partagés, lumières basses chaudes, conversations vivantes (photo moodboard à remplacer par photo réelle)" loading="lazy" />
      <div class="atmo-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 00-3-3.87"/>
          <path d="M16 3.13a4 4 0 010 7.75"/>
        </svg>
        <div>
          <span class="badge-title">Convivialité</span>
          <p class="badge-body">Des assiettes à partager, des conversations sans fin.</p>
        </div>
      </div>
    </div>

    <div class="atmo-text mb-reveal">
      <span class="atmo-kicker">L'Atmosphère</span>
      <h2 class="atmo-title">L'Art de la Table</h2>
      <p class="atmo-body">Chez Anamour, le repas est un rituel de partage. L'espace a été pensé pour ces moments où l'on oublie le temps. Autour des tables, l'hospitalité anatolienne s'exprime dans chaque détail — de la disposition des mezzés à la courtoisie du service.</p>
      <a href="#localisation" class="atmo-link">
        Réserver votre table
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .atmosphere {
    padding: var(--mb-section-py) 0;
    background: var(--mb-paper);
    overflow: hidden;
  }
  .atmosphere-wrap {
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 var(--mb-section-px);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--mb-s-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .atmosphere-wrap {
      grid-template-columns: 7fr 5fr;
      gap: var(--mb-s-9);
    }
  }

  .atmo-media { position: relative; }
  .atmo-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 30px 80px -30px rgba(0,0,0,0.6);
    display: block;
  }

  .atmo-badge {
    display: none;
  }
  @media (min-width: 900px) {
    .atmo-badge {
      display: flex;
      position: absolute;
      top: -36px;
      right: -36px;
      max-width: 290px;
      gap: var(--mb-s-4);
      padding: var(--mb-s-5) var(--mb-s-5);
      background: rgba(42, 29, 26, 0.7);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(214, 179, 138, 0.22);
      border-radius: 14px;
      box-shadow: 0 0 50px -10px rgba(255, 183, 123, 0.18);
    }
  }
  .atmo-badge svg {
    width: 28px; height: 28px;
    color: var(--mb-accent);
    flex-shrink: 0;
  }
  .badge-title {
    display: block;
    font-family: var(--mb-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--mb-ink);
    margin-bottom: 4px;
  }
  .badge-body {
    font-family: var(--mb-sans);
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--mb-ink-soft);
    margin: 0;
    max-width: none;
  }

  .atmo-kicker {
    display: block;
    font-family: var(--mb-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mb-accent);
    margin-bottom: var(--mb-s-4);
  }
  .atmo-title {
    font-family: var(--mb-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5.5vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    color: var(--mb-ink);
    margin: 0 0 var(--mb-s-5);
  }
  .atmo-body {
    font-family: var(--mb-sans);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--mb-ink-soft);
    max-width: 36rem;
    margin: 0 0 var(--mb-s-6);
  }

  .atmo-link {
    display: inline-flex;
    align-items: center;
    gap: var(--mb-s-3);
    color: var(--mb-accent);
    font-family: var(--mb-sans);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: gap 0.2s ease;
  }
  .atmo-link svg { width: 18px; height: 18px; transition: transform 0.2s ease; }
  .atmo-link:hover { gap: var(--mb-s-4); }
  .atmo-link:hover svg { transform: translateX(4px); }
</style>
