---
// Trust Bar — sous le Hero : 3 pills horaire / lieu / cuisine au feu
import { getEntry } from 'astro:content';
const entry = await getEntry('settings', 'site');
const s = entry!.data;
---
<section class="trust">
  <div class="trust-inner">
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 7v5l3 2"/>
      </svg>
      <span>Ouvert 7j/7 jusqu'à 00h30</span>
    </div>
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      <span>{s.ville} · Chartres</span>
    </div>
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 2l-1 5h10l-1-5"/>
        <path d="M12 22V8"/>
        <path d="M7 8h10v8a4 4 0 01-4 4h-2a4 4 0 01-4-4V8z"/>
      </svg>
      <span>Cuisine au feu de bois</span>
    </div>
  </div>
</section>

<style>
  .trust {
    background: #0e0e0e;
    border-top: 1px solid var(--mb-line);
    border-bottom: 1px solid var(--mb-line);
    padding: var(--mb-s-6) var(--mb-section-px);
  }
  .trust-inner {
    max-width: var(--mb-container);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--mb-s-7);
  }
  @media (min-width: 900px) {
    .trust-inner { justify-content: space-between; gap: var(--mb-s-5); }
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--mb-s-3);
    color: var(--mb-ink-soft);
    font-family: var(--mb-sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .trust-item svg {
    width: 22px; height: 22px;
    color: var(--mb-accent);
    flex-shrink: 0;
  }
</style>
