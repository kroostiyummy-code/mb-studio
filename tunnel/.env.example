# ============================================
# MB Studio Tunnel - Configuration
# ============================================
#
# INSTRUCTIONS :
# 1. Duplique ce fichier en .env (sans le .example)
# 2. Remplace les valeurs ci-dessous par tes vraies clés
# 3. NE COMMIT JAMAIS le fichier .env (protégé par .gitignore)

# Clé API Anthropic (obtenue sur console.anthropic.com)
# Format attendu : sk-ant-api03-XXXXXXXXXXXX...
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACE_PAR_TA_VRAIE_CLE

# Modèle Claude par défaut pour les agents
# Options : claude-sonnet-4-6, claude-opus-4-7
ANTHROPIC_MODEL=claude-sonnet-4-6

# Nombre maximum de tokens en sortie par appel
MAX_OUTPUT_TOKENS=4096

# Mode debug (true/false) - affiche les détails des appels API
DEBUG_MODE=false

# Chemin racine du projet (laissé vide = détection automatique)
PROJECT_ROOT=
